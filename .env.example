# ==============================================================================
# FinTrack (FinançasApp) - Variáveis de Ambiente (.env.example)
# Copie este arquivo para .env na raiz ou nas respectivas pastas e ajuste os valores:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND - SEGURANÇA & AUTENTICAÇÃO (JWT & BCRYPT)
# ------------------------------------------------------------------------------
# Chave secreta usada para assinar e validar os tokens JWT.
# IMPORTANTE: Em produção, gere uma chave criptográfica forte (mínimo 32 bytes aleatórios):
# Linux/macOS/Git Bash: openssl rand -hex 32
# PowerShell: -join ((1..32) | ForEach-Object { '{0:x2}' -f (Get-Random -Max 256) })
SECRET_KEY=fintrack_super_secret_jwt_key_2026_financas_app_secure_key_32bytes

# Algoritmo de criptografia do token JWT (padrão recomendado: HS256)
JWT_ALGORITHM=HS256

# Tempo de vida do access token em minutos (1440 = 24 horas)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# 2. BACKEND - BANCO DE DADOS
# ------------------------------------------------------------------------------
# SQLite (padrão para desenvolvimento local e testes):
DATABASE_URL=sqlite:///./financas.db

# Exemplo para PostgreSQL em produção (se for migrar/utilizar Postgres):
# DATABASE_URL=postgresql://usuario:senha@localhost:5432/fintrack

# ------------------------------------------------------------------------------
# 3. BACKEND - RATE LIMITING (SLOWAPI) & PROTEÇÃO BRUTE FORCE
# ------------------------------------------------------------------------------
# Limite para rotas sensíveis de login e cadastro (/api/auth/*)
AUTH_RATE_LIMIT=5/minute

# Limite para operações em lote (/api/transacoes/bulk-delete)
BULK_RATE_LIMIT=20/minute

# Limite geral por IP para as demais requisições da API
DEFAULT_RATE_LIMIT=120/minute

# ------------------------------------------------------------------------------
# 4. FRONTEND (VITE + REACT)
# ------------------------------------------------------------------------------
# URL base da API consumida pelo frontend (Axios)
# Para desenvolvimento local padrão: http://localhost:8000/api
# Em produção ou Docker, aponte para a URL do seu domínio ou gateway
VITE_API_URL=http://localhost:8000/api

# ------------------------------------------------------------------------------
# 5. DOCKER & SISTEMA
# ------------------------------------------------------------------------------
# Garante que os logs do Python sejam emitidos imediatamente no terminal/Docker
PYTHONUNBUFFERED=1
